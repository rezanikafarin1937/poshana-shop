{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
, "src/app/login/page.jsx", "src/app/api/products/route.js", "src/utils/pagination/Pagination.jsx", "src/app/(cat)/boys/page.jsx", "src/app/(cat)/feminine/page.jsx", "src/app/(cat)/girls/page.jsx", "src/app/(cat)/kidswear/page.jsx", "src/app/(cat)/menswear/page.jsx", "src/app/cart/page.jsx", "src/app/dashboard/page.jsx", "src/app/fetch-client/page.jsx", "src/app/search/page.jsx", "src/app/store/page.jsx", "src/app/store/[id]/page.jsx", "src/components/horizontal-scroll/HorizontalScroll.tsx"  ],
  "exclude": ["node_modules"]
}
